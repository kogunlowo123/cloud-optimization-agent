# Copy to .env and adjust. Every variable is optional.

# Configuration files
# CLOUDOPT_PRICING_FILE=configs/pricing.example.yaml
# CLOUDOPT_POLICY_FILE=configs/policy.example.yaml

# Ingestion limits
CLOUDOPT_MAX_LINE_BYTES=100000
CLOUDOPT_MAX_RECORDS=3000000

# Optional model-written summaries
# llm_provider: none | openai | anthropic. The model only sees aggregate figures, never resource names.
CLOUDOPT_LLM_PROVIDER=none
# CLOUDOPT_OPENAI_API_KEY=
CLOUDOPT_OPENAI_BASE_URL=https://api.openai.com/v1
CLOUDOPT_OPENAI_CHAT_MODEL=gpt-4o-mini
# CLOUDOPT_ANTHROPIC_API_KEY=
CLOUDOPT_ANTHROPIC_BASE_URL=https://api.anthropic.com
CLOUDOPT_ANTHROPIC_MODEL=claude-sonnet-5
CLOUDOPT_ANTHROPIC_MAX_TOKENS=500

# HTTP and logging
CLOUDOPT_HTTP_TIMEOUT_SECONDS=30
CLOUDOPT_RETRY_ATTEMPTS=3
CLOUDOPT_RETRY_MIN_WAIT=0.5
CLOUDOPT_RETRY_MAX_WAIT=8
CLOUDOPT_LOG_LEVEL=WARNING
CLOUDOPT_LOG_JSON=true
